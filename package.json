{
  "name": "evolve-doc",
  "version": "1.0.0",
  "description": "EvolveDoc — multi-LLM document evolution framework",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.0.0"
  },
  "bin": {
    "evolvedoc": "./bin/evolvedoc"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.85",
    "@openai/codex-sdk": "^0.117.0",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "gray-matter": "^4.0.3",
    "openai": "^6.33.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
